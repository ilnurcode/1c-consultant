// ДЕФЕКТ v8std:comment-api:
// Экспортная процедура не имеет обязательной шапки описания параметров
Процедура ОтправитьДанныеВШлюз(ДанныеПакета, АдресСервера) Экспорт
	
	// ДЕФЕКТ SEC003: Включение привилегированного режима без проверки прав
	УстановитьПривилегированныйРежим(Истина);
	
	// ДЕФЕКТ SEC005: Запуск внешней команды ОС без валидации аргумента
	КомандаСистемы("curl.exe -X POST " + АдресСервера);
	
	// ДЕФЕКТ PERF001: Запрос внутри цикла (проблема N+1)
	Для каждого Элемент Из ДанныеПакета Цикл
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ Ссылка ИЗ Справочник.Номенклатура ГДЕ Код = &Код";
		Запрос.УстановитьПараметр("Код", Элемент.Код);
		Выборка = Запрос.Выполнить().Выбрать();
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

#КонецОбласти
